# Deploy the Cloudflare Worker in cloudflare-worker/ and paste its URL here.
# The browser will call the Worker directly — LinkedIn requests use Cloudflare edge IPs,
# not your app server, so each user gets a distinct IP and concurrent usage works.
# If this is not set, the app falls back to the server-side /api/jobs/linkedin-proxy endpoint.
VITE_LINKEDIN_PROXY_URL=https://linkedin-cors-proxy.<your-subdomain>.workers.dev
